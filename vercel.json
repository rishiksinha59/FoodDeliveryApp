{
    "services": {
        "frontend": {
            "root": "frontend",
            "framework": "vite"
        },
        "admin": {
            "root": "admin",
            "framework": "vite"
        },
        "backend": {
            "root": "backend",
            "entrypoint": "server.js",
            "functions": {
                "server.js": {
                    "includeFiles": "uploads/**"
                }
            }
        }
    },
    "rewrites": [
        {
            "source": "/api(/.*)?",
            "destination": {
                "type": "service",
                "service": "backend"
            }
        },
        {
            "source": "/images(/.*)?",
            "destination": {
                "type": "service",
                "service": "backend"
            }
        },
        {
            "source": "/admin(/.*)?",
            "destination": {
                "type": "service",
                "service": "admin"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "type": "service",
                "service": "frontend"
            }
        }
    ]
}
